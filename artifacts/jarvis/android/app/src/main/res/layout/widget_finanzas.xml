<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_finanzas_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: Título y fecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_finanzas_title"
            android:textColor="#F5F5F7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_finanzas_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A8A96"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Saldo Total Grande -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo Total: "
            android:textColor="#8A8A96"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_finanzas_saldo_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0 COP"
            android:textColor="#5DE8C4"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Flujo de Hoy: Gastos vs Ingresos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Gastos de hoy -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gastos hoy"
                android:textColor="#8A8A96"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_finanzas_gastos_hoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-$0 COP"
                android:textColor="#E85D5D"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ingresos de hoy -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entradas hoy"
                android:textColor="#8A8A96"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_finanzas_ingresos_hoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+$0 COP"
                android:textColor="#5DE87A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer: Medios de pago / Estado -->
    <TextView
        android:id="@+id/widget_finanzas_medios_summary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#A0A0B0"
        android:textSize="10sp" />

    <!-- Actualizado en -->
    <TextView
        android:id="@+id/widget_finanzas_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:textColor="#5A5A66"
        android:textSize="9sp" />
</LinearLayout>
