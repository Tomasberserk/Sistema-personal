# Copia este archivo como .env y completa solo el proveedor que vayas a usar.
# NUNCA subas .env al repositorio.
#
# Seleccion:
#   ASSISTANT_PROVIDER=mock | xai | groq
# Si se omite, el backend usa xAI si encuentra XAI_API_KEY, luego Groq si
# encuentra GROQ_API_KEY, y si no hay ninguna clave usa el mock.

ASSISTANT_PROVIDER=

# --- xAI Grok (claves que empiezan por xai-) ---
XAI_API_KEY=
XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1

# --- Groq (claves que empiezan por gsk_) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
